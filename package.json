{
  "name": "haut-spare-ui",
  "version": "1.0.0",
  "description": "NX Angular Micro Frontend Architecture with Module Federation",
  "license": "MIT",
  "scripts": {
    "serve": "concurrently \"npm run serve:shell\" \"npm run serve:admin\" \"npm run serve:member\"",
    "serve:shell": "nx serve shell --port 4200",
    "serve:admin": "nx serve admin --port 4201",
    "serve:member": "nx serve member --port 4202",
    "build": "nx run-many --target=build --all",
    "build:shell": "nx build shell",
    "build:admin": "nx build admin",
    "build:member": "nx build member",
    "build:prod": "nx run-many --target=build --all --prod",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all -- --fix",
    "test": "nx run-many --target=test --all",
    "test:shell": "nx test shell",
    "test:admin": "nx test admin",
    "test:member": "nx test member",
    "e2e": "nx run-many --target=e2e --all"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^14.2.0",
    "@angular/animations": "^14.2.0",
    "@angular/common": "^14.2.0",
    "@angular/compiler": "^14.2.0",
    "@angular/core": "^14.2.0",
    "@angular/forms": "^14.2.0",
    "@angular/platform-browser": "^14.2.0",
    "@angular/platform-browser-dynamic": "^14.2.0",
    "@angular/router": "^14.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.12.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^14.0.0",
    "@angular-eslint/eslint-plugin-template": "^14.0.0",
    "@angular/cli": "^14.2.0",
    "@angular/compiler-cli": "^14.2.0",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "concurrently": "^8.0.1",
    "cypress": "^13.0.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "nx": "14.3.0",
    "prettier": "^2.8.8",
    "typescript": "^4.8.4",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}
